// Phase 2+ PostgreSQL schema — mirrors file-backed content in content/data/
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConfidenceLevel {
  confirmed
  strongly_documented
  probable
  disputed
  unknown
}

enum OriginType {
  designed_in_iran
  developed_in_iran
  manufactured_in_iran
  assembled_in_iran
  licensed
  imported
  modified
  reverse_engineered
  joint
  captured
  disputed_attribution
}

enum Model3dProvenance {
  archival
  reconstructed
  approximate
  concept
  none
}

enum Model3dStatus {
  available
  placeholder
  none
}

enum RelationType {
  influenced
  variant_of
  derived_from
  replaced_by
  licensed_from
  successor_of
  related_program
  operated_alongside
}

model Category {
  id          String   @id
  slug        String   @unique
  nameEn      String
  nameFa      String
  descriptionEn String
  descriptionFa String
  sortOrder   Int
  systems     System[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HistoricalPeriod {
  id            String   @id
  slug          String   @unique
  nameEn        String
  nameFa        String
  yearStart     Int
  yearEnd       Int?
  descriptionEn String
  descriptionFa String
  systems       SystemPeriod[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([yearStart])
}

model Source {
  id              String   @id
  title           String
  url             String
  authorOrOrg     String
  publishedAt     String?
  accessedAt      String
  relevantClaimEn String
  relevantClaimFa String
  confidence      ConfidenceLevel
  notesEn         String?
  notesFa         String?
  conflictsWith   String[]
  systemRefs      SystemSource[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model System {
  id                         String          @id
  slug                       String          @unique
  designation                String
  nameEn                     String
  nameFa                     String
  alternativeNames           String[]
  categoryId                 String
  category                   Category        @relation(fields: [categoryId], references: [id])
  originCountry              String
  originType                 OriginType
  developerEn                String
  developerFa                String
  manufacturerEn             String
  manufacturerFa             String
  developmentPeriod          String?
  introductionPeriod         String?
  productionStatusEn         String
  productionStatusFa         String
  serviceStatusEn            String
  serviceStatusFa            String
  descriptionEn              String          @db.Text
  descriptionFa              String          @db.Text
  historicalContextEn        String          @db.Text
  historicalContextFa        String          @db.Text
  technologicalSignificanceEn String         @db.Text
  technologicalSignificanceFa String         @db.Text
  confidence                 ConfidenceLevel
  model3dStatus              Model3dStatus
  model3dUrl                 String?
  model3dProvenance          Model3dProvenance
  model3dLicense             String
  periods                    SystemPeriod[]
  sources                    SystemSource[]
  specifications             Specification[]
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([categoryId])
  @@index([designation])
}

model SystemPeriod {
  systemId String
  periodId String
  system   System           @relation(fields: [systemId], references: [id])
  period   HistoricalPeriod @relation(fields: [periodId], references: [id])

  @@id([systemId, periodId])
}

model SystemSource {
  systemId String
  sourceId String
  system   System @relation(fields: [systemId], references: [id])
  source   Source @relation(fields: [sourceId], references: [id])

  @@id([systemId, sourceId])
}

model Specification {
  id           String          @id
  systemId     String
  system       System          @relation(fields: [systemId], references: [id])
  labelEn      String
  labelFa      String
  valueEn      String
  valueFa      String
  confidence   ConfidenceLevel
  sourceIds    String[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([systemId])
}
