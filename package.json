{
  "name": "iran-military-tech-museum",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NITRO_PRESET=cloudflare_module nuxt build",
    "build:pages": "NITRO_PRESET=cloudflare-pages nuxt build",
    "build:node": "NITRO_PRESET=node-server nuxt build",
    "dev": "NUXT_TELEMETRY_DISABLED=1 nuxt dev --port 43123 --host 127.0.0.1",
    "generate": "nuxt generate",
    "preview": "NUXT_TELEMETRY_DISABLED=1 nuxt preview --port 43123 --host 127.0.0.1",
    "start": "HOST=127.0.0.1 PORT=43123 node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "db:generate": "prisma generate",
    "deploy:cloudflare": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^9.5.6",
    "@tresjs/cientos": "^4.3.0",
    "@tresjs/core": "^4.3.3",
    "@tresjs/nuxt": "^4.0.0",
    "nuxt": "^4.5.2",
    "three": "^0.175.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@prisma/client": "^6.16.1",
    "@types/three": "^0.175.0",
    "prisma": "^6.16.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.134.0"
  }
}
